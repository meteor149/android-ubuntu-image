ARG UBUNTU_IMAGE=ubuntu:24.04
FROM ${UBUNTU_IMAGE} AS runtime
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates curl git libstdc++6 openssh-client python3 ripgrep \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*
RUN mkdir -p /workspace /root /tmp
FROM --platform=$BUILDPLATFORM ubuntu:24.04 AS packer
RUN apt-get update && apt-get install -y --no-install-recommends tar zstd && rm -rf /var/lib/apt/lists/*
COPY --from=runtime / /rootfs
RUN mkdir -p /out && tar --numeric-owner --xattrs --acls -C /rootfs -cf - . | zstd -19 -o /out/ubuntu-arm64.tar.zst -
FROM scratch AS artifact
COPY --from=packer /out/ubuntu-arm64.tar.zst /
